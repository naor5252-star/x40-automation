{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreame-presence-automation",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "vars": {
    "DRY_RUN": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "PresenceState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PresenceState"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}